{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "deploy": "npm run build",
    "start": "next start",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "check": "biome check ./src",
    "format": "biome format ./src --write",
    "format:check": "biome format ./src --check",
    "ci-check": "biome check ./src && tsc --noEmit && next build",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "update": "npm update",
    "outdated": "npm outdated",
    "clean": "rm -rf .next node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "type-check": "tsc --noEmit",
    "test:build": "npm run build && npm run start",
    "analyze": "next experimental-analyze",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "js-cookie": "3.0.7",
    "sharp": "$sharp",
    "postcss-selector-parser": "7.1.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome lint --write",
      "biome format --write"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.19",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-bullet-list": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-history": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list-item": "^3.32.0",
    "@tiptap/extension-ordered-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "html-react-parser": "^6.1.9",
    "html-to-text": "^10.0.0",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "open-graph-scraper": "^6.12.0",
    "plaiceholder": "^3.0.0",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-server-dom-parcel": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@clerk/testing": "^2.2.49",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/gtag.js": "^0.0.20",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.31",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.14",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
